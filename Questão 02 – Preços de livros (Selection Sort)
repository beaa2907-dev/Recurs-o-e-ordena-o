
import java.util.Scanner;
import java.util.Locale;

public class Questao02 {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        sc.useLocale(Locale.US);

        int s = sc.nextInt();

        for (int i = 1; i <= s; i++) {
            int n = sc.nextInt();
            double[] precos = new double[n];

            for (int j = 0; j < n; j++) {
                precos[j] = sc.nextDouble();
            }

            // Selection Sort
            for (int j = 0; j < n - 1; j++) {
                int menor = j;

                for (int k = j + 1; k < n; k++) {
                    if (precos[k] < precos[menor]) {
                        menor = k;
                    }
                }

                double temp = precos[j];
                precos[j] = precos[menor];
                precos[menor] = temp;
            }

            System.out.print("Precos ordenados da secao " + i + ": ");

            for (double preco : precos) {
                System.out.printf("%.2f ", preco);
            }

            System.out.println();

            System.out.printf("Preco mais barato da secao %d: %.2f%n",
                    i, precos[0]);

            System.out.printf("Preco mais caro da secao %d: %.2f%n",
                    i, precos[n - 1]);
        }

        sc.close();
    }
}
