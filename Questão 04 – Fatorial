
import java.util.Scanner;

public class Questao04 {

    public static long fatorial(int n) {

        if (n == 0) {
            return 1;
        }

        return n * fatorial(n - 1);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        System.out.println(fatorial(n));

        sc.close();
    }
}
