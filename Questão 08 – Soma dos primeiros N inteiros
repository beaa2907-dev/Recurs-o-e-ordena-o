
import java.util.Scanner;

public class Questao08 {

    public static int soma(int n) {

        if (n == 0) {
            return 0;
        }

        return n + soma(n - 1);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        System.out.println(soma(n));

        sc.close();
    }
}
